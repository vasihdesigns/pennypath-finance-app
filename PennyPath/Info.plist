<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Publishes the app's iCloud container so its Documents folder (where data
	     backups are written) is visible and browsable under Files → iCloud Drive →
	     PennyPath. This lets the user re-import a backup with the normal file picker.
	     The rest of Info.plist is generated by Xcode (GENERATE_INFOPLIST_FILE=YES)
	     and merged on top of these keys at build time. -->
	<key>NSUbiquitousContainers</key>
	<dict>
		<key>iCloud.com.vasih.PennyPath</key>
		<dict>
			<key>NSUbiquitousContainerIsDocumentScopePublic</key>
			<true/>
			<key>NSUbiquitousContainerName</key>
			<string>PennyPath</string>
			<key>NSUbiquitousContainerSupportedFolderLevels</key>
			<string>Any</string>
		</dict>
	</dict>
</dict>
</plist>
